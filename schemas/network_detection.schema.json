{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarr-core-engine.local/schemas/network-detection.schema.json",
  "title": "SARR-Core network detection configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "port_scan_unique_ports",
    "window_seconds",
    "syn_flood_threshold_per_second",
    "max_tracked_ips",
    "max_blocked_ips",
    "inactive_timeout_seconds",
    "cooldown_seconds",
    "allowlist"
  ],
  "properties": {
    "port_scan_unique_ports": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "window_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "syn_flood_threshold_per_second": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "max_tracked_ips": {
      "type": "integer",
      "minimum": 1
    },
    "max_blocked_ips": {
      "type": "integer",
      "minimum": 1
    },
    "inactive_timeout_seconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cooldown_seconds": {
      "type": "number",
      "minimum": 0
    },
    "allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
