{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sarr-core-engine.local/schemas/dashboard.schema.json",
  "title": "SARR-Core local dashboard configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "panels"],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "panels": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "kind", "metrics"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "enum": ["timeseries", "stat", "table"]
          },
          "metrics": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "enum": [
                "cpu_percent",
                "ram_percent",
                "rtt_ms",
                "drop_rate",
                "status_code",
                "duration_ms",
                "volume_bytes"
              ]
            }
          }
        }
      }
    }
  }
}
